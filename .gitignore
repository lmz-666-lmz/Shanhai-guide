# === Node.js dependencies ===
node_modules/
frontend/node_modules/
admin-frontend/node_modules/
.pnpm-store/

# === Build output ===
dist/
frontend/dist/
admin-frontend/dist/
dist-ssr/
*.tsbuildinfo

# === Uploaded files (keep directory, ignore contents) ===
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep

# === Maven build output ===
target/
backend/target/

# === IDE ===
.idea/
*.iml
.vscode/

# === Logs ===
*.log
outputs/
work/
backend/build_error.txt
backend/build_output.txt

# === Accidental helper scripts / locks ===
backend/package-lock.json

# === Environment & secrets (real keys — DO NOT commit) ===
.env
.env.local
*.env.local
backend/src/main/resources/application.yml
backend/src/main/resources/application-local.yml

# But allow example/template configs
!.env.example
!frontend/.env.example
!admin-frontend/.env.example
!backend/src/main/resources/application-example.yml

# === OS files ===
.DS_Store
Thumbs.db
*.swp
*.swo

# === Test coverage ===
coverage/

# === Vite cache ===
.vite/
